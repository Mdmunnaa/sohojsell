{% load static %}{
  "name": "{{ site.name }}",
  "short_name": "{{ site.name }}",
  "start_url": "/dashboard/",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#D63A2F",
  "icons": [
    {"src": "{% static 'brand/icon-192.png' %}", "sizes": "192x192", "type": "image/png"},
    {"src": "{% static 'brand/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ]
}
