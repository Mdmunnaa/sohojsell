{
  "name": "sellpunch-cloudflare",
  "private": true,
  "description": "SellPunch-এর Django অ্যাপ Cloudflare Containers-এ চালানোর Worker",
  "scripts": {
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && wrangler deploy --dry-run --containers-rollout=none",
