# এই ফাইলটা কপি করে .env বানাবেন না — Render-এ এগুলো Environment-এ বসাবেন।
# লোকালে কিছু না দিলে SQLite আর media/ ফোল্ডার দিয়ে চলবে।

SECRET_KEY=                       # Render নিজে বানিয়ে দেবে (render.yaml)
DEBUG=False                       # Render-এ ডিফল্ট False, লোকালে ডিফল্ট True

# Neon > Project > Connection string (sslmode=require সহ)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/sohojsell?sslmode=require

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sohojsell-media
R2_PUBLIC_DOMAIN=pub-xxxx.r2.dev  # https:// ছাড়া

# প্রথম deploy-এ admin অ্যাকাউন্ট
DJANGO_SUPERUSER_PHONE_NUMBER=
DJANGO_SUPERUSER_PASSWORD=

# দোকানগুলোর সাবডোমেইন যে ডোমেইনের নিচে (যেমন sohojsell.com → munnafashion.sohojsell.com)।
# আগে Render-এ sohojsell.com আর *.sohojsell.com দুটো Custom Domain যোগ করে DNS ঠিক করুন, তারপর এটা বসান।
# খালি থাকলে দোকানের লিংক হয় https://<render-ঠিকানা>/shop/<সাবডোমেইন>/
STORE_BASE_DOMAIN=

# Premium দোকানের নিজের ডোমেইন (যেমন www.munnashop.com) চালু করলে এখানেও যোগ করুন (কমা দিয়ে আলাদা)
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# ব্যবসার তথ্য — footer, যোগাযোগ আর নীতিমালার পেইজে দেখায় (Meta আর PayStation এগুলো দেখে)
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=                 # দেশের কোডসহ, যেমন 8801XXXXXXXXX
BUSINESS_LEGAL_NAME=              # ট্রেড লাইসেন্সে যে নাম
BUSINESS_ADDRESS=
FACEBOOK_PAGE_URL=

# PayStation — কিছু না দিলে PayStation-এর পাবলিক sandbox (টেস্ট) চলে
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
PAYSTATION_ENVIRONMENT=sandbox    # merchant পেলে live
PAYSTATION_PAY_WITH_CHARGE=0
PAYSTATION_TEST_SHOPS=            # sandbox-এ যে শপগুলো অনলাইন পেমেন্ট টেস্ট করবে (slug, কমা দিয়ে)

# Facebook কমেন্ট থেকে অর্ডার (Meta App → Webhooks → Page → feed)
# Callback URL: https://<ডোমেইন>/facebook/webhook/ ; Verify Token নিজে একটা লম্বা র‍্যান্ডম লেখা বানিয়ে দুই জায়গায় একই দিন
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=              # Meta App → Settings → Basic → App Secret (খালি থাকলে Admin-এর Social App থেকে নেয়)
SITE_URL=                         # যেমন https://sohojsell.com (খালি থাকলে Render-এর ঠিকানা)
FACEBOOK_LOGIN_CONFIG_ID=         # Facebook Login for Business → Configurations-এর ID (থাকলে)

# কাস্টমারের অনলাইন পেমেন্ট থেকে প্ল্যাটফর্মের ফি (%), বাকিটা সেলারের পাওনা
STOREFRONT_PAYMENT_FEE_PERCENT=2
