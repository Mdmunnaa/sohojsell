# এই ফাইলটা কপি করে .env বানাবেন না — Render-এ এগুলো Environment-এ বসাবেন।
# লোকালে কিছু না দিলে SQLite আর media/ ফোল্ডার দিয়ে চলবে।

SECRET_KEY=                       # Render নিজে বানিয়ে দেবে (render.yaml)
DEBUG=False                       # Render-এ ডিফল্ট False, লোকালে ডিফল্ট True

# Neon > Project > Connection string (sslmode=require সহ)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/sohojsell?sslmode=require

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sohojsell-media
R2_PUBLIC_DOMAIN=pub-xxxx.r2.dev  # https:// ছাড়া

# প্রথম deploy-এ admin অ্যাকাউন্ট
DJANGO_SUPERUSER_PHONE_NUMBER=
DJANGO_SUPERUSER_PASSWORD=

# নিজের ডোমেইন যোগ করলে (কমা দিয়ে আলাদা)
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
